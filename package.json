{
  "name": "ekko-webgpu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run lint:wgsl && npm run assets && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate-remixes.mjs",
    "deploy": "node scripts/deploy.mjs",
    "lint:wgsl": "node scripts/lint-wgsl.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@neondatabase/serverless": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@webgpu/types": "^0.1.69",
    "esbuild": "^0.25.11",
    "naga-wasi-cli": "0.1.0",
    "vite": "^7.2.2"
  }
}
