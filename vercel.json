{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/youtube.py": {
      "maxDuration": 60,
      "excludeFiles": "{public/**,dist/**,node_modules/**,src/**,tests/**,scripts/**,references/**}"
    }
  },
  "rewrites": [
    {
      "source": "/remix/(.*)",
      "destination": "/remix/index.html"
    }
  ]
}
