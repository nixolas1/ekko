{
  "openapi": "3.1.0",
  "info": {
    "title": "EKKO Remix API",
    "version": "1.0.0",
    "description": "Read remix-guide.md first. Agent-created previews should be unlisted. Never expose editing keys."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/remixes": {
      "get": {
        "operationId": "readRemixes",
        "summary": "Read gallery, a scene, history, or shader schema",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          {
            "name": "action",
            "in": "query",
            "schema": {
              "enum": [
                "schema",
                "history"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid document"
          },
          "403": {
            "description": "Invalid edit key or origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict"
          },
          "413": {
            "description": "Too large"
          },
          "415": {
            "description": "Expected JSON"
          },
          "429": {
            "description": "Hourly limit"
          },
          "503": {
            "description": "Storage not configured"
          }
        }
      },
      "post": {
        "operationId": "createRemix",
        "summary": "Create an unlisted draft or explicitly publish a scene; returns a private editing key once",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "document"
                ],
                "properties": {
                  "document": {
                    "$ref": "#/components/schemas/Document"
                  },
                  "visibility": {
                    "enum": [
                      "unlisted",
                      "public"
                    ],
                    "default": "unlisted"
                  },
                  "thumbnail": {
                    "type": "string",
                    "maxLength": 110000
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  },
                  "parentId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid"
                  },
                  "parentRevision": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid document"
          },
          "403": {
            "description": "Invalid edit key or origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict"
          },
          "413": {
            "description": "Too large"
          },
          "415": {
            "description": "Expected JSON"
          },
          "429": {
            "description": "Hourly limit"
          },
          "503": {
            "description": "Storage not configured"
          },
          "201": {
            "description": "Created; includes id, revision, url, editKey, editUrl, document"
          }
        }
      },
      "put": {
        "operationId": "updateRemix",
        "summary": "Append a revision owned by the editing key; expectedRevision is required",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "editKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "document",
                  "expectedRevision"
                ],
                "properties": {
                  "document": {
                    "$ref": "#/components/schemas/Document"
                  },
                  "visibility": {
                    "enum": [
                      "unlisted",
                      "public"
                    ],
                    "default": "unlisted"
                  },
                  "thumbnail": {
                    "type": "string",
                    "maxLength": 110000
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  },
                  "parentId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid"
                  },
                  "parentRevision": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid document"
          },
          "403": {
            "description": "Invalid edit key or origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict"
          },
          "413": {
            "description": "Too large"
          },
          "415": {
            "description": "Expected JSON"
          },
          "429": {
            "description": "Hourly limit"
          },
          "503": {
            "description": "Storage not configured"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Document": {
        "type": "object",
        "required": [
          "version",
          "title",
          "description",
          "author",
          "mode",
          "code"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 600
          },
          "author": {
            "type": "string",
            "maxLength": 60
          },
          "mode": {
            "type": "string",
            "enum": [
              "plume",
              "plume-glow",
              "duet",
              "spectral",
              "fluid-ring",
              "smoke",
              "ring",
              "persistent",
              "sculpture"
            ]
          },
          "settings": {
            "type": "object",
            "properties": {
              "palette": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "effect": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "count": {
                "type": "integer",
                "minimum": 32768,
                "maximum": 524288
              },
              "speed": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 2
              },
              "glow": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "emission": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "turbulence": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "visibility": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 4
              }
            },
            "additionalProperties": false
          },
          "code": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "editKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Capability from the private editing link; never share publicly."
      }
    }
  }
}
